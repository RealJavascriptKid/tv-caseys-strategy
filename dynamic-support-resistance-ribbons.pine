//@version=5
indicator("SaadPro's Dynamic Support Resistance Ribbons", overlay=true)

// CONSTANTS (Hard-coded to hide from settings)
adxLength    = 14
adxThreshold = 25.0
fastEMA       = 9
midEMA        = 21
slowEMA       = 50
useVWAP       = true

// INDICATORS
emaFast = ta.ema(close, fastEMA)
emaMid  = ta.ema(close, midEMA)
emaSlow = ta.ema(close, slowEMA)

vwapValue = ta.vwap(close)

[diplus, diminus, adxValue] = ta.dmi(adxLength, adxLength)

// CONDITIONS
bullishEMAStack = emaFast > emaMid and emaMid > emaSlow
bearishEMAStack = emaFast < emaMid and emaMid < emaSlow

bullishVWAP = close > vwapValue
bearishVWAP = close < vwapValue

strongTrend = adxValue > adxThreshold

longSignal  = strongTrend and bullishEMAStack and (not useVWAP or bullishVWAP)
shortSignal = strongTrend and bearishEMAStack and (not useVWAP or bearishVWAP)

// STATE TRACKING WITH RESET LOGIC
var int activeTrend = 0 

// Logic to reset the trend state if price crosses the Slow EMA
if activeTrend == 1 and close < emaSlow
    activeTrend := 0
else if activeTrend == -1 and close > emaSlow
    activeTrend := 0

// MODIFIED SIGNAL LOGIC
// Only allow a signal if the activeTrend is currently neutral (0)
buySignal  = longSignal and activeTrend == 0
sellSignal = shortSignal and activeTrend == 0

// Update State after signal detection
if buySignal
    activeTrend := 1
else if sellSignal
    activeTrend := -1

// PLOTS
// Internal plots hidden from Style Tab via editable=false
p1 = plot(emaFast, title="Fast EMA", display=display.none, editable=false)
p2 = plot(emaMid, title="Mid EMA", display=display.none, editable=false)

// Slow EMA (Signal Line)
slowColor = (activeTrend == 1 and bullishEMAStack) ? color.green : (activeTrend == -1 and bearishEMAStack) ? color.red : color.gray
p3 = plot(emaSlow, color=slowColor, title="Signal Line", linewidth=3)

// RIBBON 1: FAST TO MID
bandColor1 = (activeTrend == 1) ? color.new(color.green, 75) : (activeTrend == -1) ? color.new(color.red, 75) : na
fill(p1, p2, color=bandColor1, title="Fast-Mid Ribbon")

// RIBBON 2: MID TO SLOW
bandColor2 = (activeTrend == 1 and bullishEMAStack) ? color.new(color.green, 85) : (activeTrend == -1 and bearishEMAStack) ? color.new(color.red, 85) : na
fill(p2, p3, color=bandColor2, title="Mid-Slow Fanned Ribbon")

// BUY/SELL LABELS
// These will now only appear once per "Trend Cycle"
plotshape(buySignal, title="SUPPORT RIBBON", text="support", style=shape.arrowup, location=location.belowbar, color=color.lime, textcolor=color.white, size=size.small)
plotshape(sellSignal, title="RESISTANCE RIBBON", text="resistance", style=shape.arrowdown, location=location.abovebar, color=color.red, textcolor=color.white, size=size.small)